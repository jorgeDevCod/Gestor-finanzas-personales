{
  "name": "gestor-finanzas-personales",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:smoke": "esbuild smoke.test.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/gfp-smoke.cjs --log-level=error && node node_modules/.cache/gfp-smoke.cjs",
    "test": "npm run typecheck && npm run lint && npm run test:smoke && npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^6.0.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
